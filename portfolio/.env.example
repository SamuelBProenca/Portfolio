# Server-only. Never use a NEXT_PUBLIC_ prefix for these values.
RESEND_API_KEY=
CONTACT_TO_EMAIL=contact@example.com
# Use a plain email address on a domain verified in Resend.
CONTACT_FROM_EMAIL=

# Serverless / multiple instances: durable, shared contact quotas (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local/self-hosted only. Vercel always requires shared Redis quotas.
CONTACT_RATE_LIMIT_MODE=

# Optional published Google Forms responder link. No secret. Rebuild after setting.
# Accepted: https://forms.gle/FORM_ID or https://docs.google.com/forms/d/e/FORM_ID/viewform
# Until configured, the public section offers the owner's approved email directly.
PROJECT_INTAKE_FORM_URL=

# Optional server/build configuration. Public origin of the separate Flask project.
# No secret, path or NEXT_PUBLIC_ prefix. Redeploy the portfolio after changing it.
CURRICULUM_STUDIO_ORIGIN=

# Optional server-only source. Empty: fetch public GitHub data directly.
# When a deployed OctoCards API exists, use its HTTPS origin (not a Git repository URL).
OCTOCARDS_API_ORIGIN=
# Optional GitHub public-read credential, used only for direct GitHub requests.
GITHUB_TOKEN=
