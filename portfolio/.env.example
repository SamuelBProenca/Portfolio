# Server-only. Never use a NEXT_PUBLIC_ prefix for these values.
RESEND_API_KEY=
CONTACT_TO_EMAIL=samuelbrito782@gmail.com
# Use a plain email address on a domain verified in Resend.
CONTACT_FROM_EMAIL=

# Serverless / multiple instances: durable, shared contact quotas (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local/self-hosted only. Vercel always requires shared Redis quotas.
CONTACT_RATE_LIMIT_MODE=

# Optional server/build configuration. Public origin of the separate Flask project.
# No secret, path or NEXT_PUBLIC_ prefix. Redeploy the portfolio after changing it.
CURRICULUM_STUDIO_ORIGIN=
